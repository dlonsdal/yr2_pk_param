# Loading dose at St George's is 60 mg/kg. We do not have weight,
# so I am going to use 4.5g loading dose (75 kg patient)
# Will then stick with the 250/500/750/1000 twice daily maintenance dose
lev.dose<-c(250,500,750,1000)
t.obs<-seq(0,71.9,0.1)
simLE<-list()
for(j in c(1:length(lev.dose))){
for(i in c(1:nrow(sample_distribution))){
dose<-data.frame(t.dose=c(seq(0,72,12)),amt=c(4500,rep(lev.dose[j],length(seq(0,72,12))-1)))
y<-pkprofile(t.obs,cl=sample_distribution$CL[i],
vc=sample_distribution$V[i],
dose=dose)
sim<-as.data.frame(y) %>%
mutate(lev.dose=lev.dose[j])
simLE[[i+(10000*(j-1))]]<-sim
}
}
simlecmin<-bind_rows(simLE)
#calculate quantiles by grouping variable
plottab <-simlecmin %>%
group_by(lev.dose,time) %>%
summarize(ten = quantile(conc, probs = 0.1),
median = median(conc),
ninety = quantile(conc, probs = 0.9)) %>%
ungroup()
ggplot(plottab,aes(x=time,y=median))+
geom_ribbon(aes(ymin=ten,ymax=ninety),fill="lightblue",alpha=0.8)+
geom_line(linetype="dashed")+
labs(y = "Leviteracetam concentration (mg/L)", x="Time (hours)" )+
theme_bw(base_size=12)+
theme(strip.background=element_rect(fill=NA, color=NA))+
geom_ribbon(aes(ymin=12, ymax=46),col=NA,fill='salmon',alpha=0.4)+
facet_wrap(vars(lev.dose),
labeller = labeller(lev.dose = dose.labs))+
theme(legend.position="none")
