library(tidyverse)
library(rcanvas)
knitr::opts_chunk$set(echo = TRUE, fig.pos= "H")
library(tidyverse)
library(kableExtra)
library(knitr)
library(httr)
library(jsonlite)
library(gtsummary)
library(readxl)
data<-read_excel("AED Systematic Review - Final Raw Data corrected.xlsx",sheet=1,skip=1)
# Cannot calculate VD from Chappell as it is not total clearance.
# Deleted cells BA19 onward
#(Chappell - need to ask Joe if this is reasonable to do using provided data and
#then assuming one compartment model)
logpkparam<-data %>%
dplyr::select(ELIM_RATE,VDRAW_UNADJ) %>%
mutate_all(~log(.x))
meanlogpk<-logpkparam %>%
summarise_all(~mean(.x,na.rm=T))%>%
unlist(., use.names=FALSE)
covmat<-cov(logpkparam,use="pairwise.complete.obs")
#create covariance matrix, pairwise complete used to skip NA
set.seed(12345)
sample_size<-10000
library(MASS)
sample_distribution<-mvrnorm(n=sample_size,
mu=meanlogpk,
Sigma = covmat) %>%
as.data.frame() %>%
mutate_all(~exp(.x)) %>%
mutate(CL = ELIM_RATE*VDRAW_UNADJ) %>%
rename(V = VDRAW_UNADJ)
ggplot(sample_distribution,aes(ELIM_RATE)) +
geom_histogram(color="steelblue4",fill="steelblue3")+
theme_bw(base_size = 14)+
xlab(NULL)+
ylab('Frequency')
ggplot(sample_distribution,aes(V)) +
geom_histogram(color="steelblue4",fill="steelblue3")+
theme_bw(base_size = 14)+
xlab(NULL)+
ylab('Frequency')
ggplot(sample_distribution,aes(CL)) +
geom_histogram(color="steelblue4",fill="steelblue3")+
theme_bw(base_size = 14)+
xlab(NULL)+
ylab('Frequency')
#Although therapeutic drug monitoring is not well defined for levetiracetam,
# a range of approximately 10–40 mg/L has been suggested [9-11]. Chappel
# goal trough concentration of 12.0–46.0 lg/ml nei et al. 2015
# I am going to assume that it is total drug being measured and targeted
library(linpk)
lev.dose<-c(250,500,750,1000)
t.obs<-c(0,71.9) # assume steady state achieved at 71.9 hours (no loading dose)
simLE<-list()
for(j in c(1:length(lev.dose))){
for(i in c(1:nrow(sample_distribution))){
dose<-data.frame(t.dose=c(seq(0,72,12)),amt=lev.dose[j])
y<-pkprofile(t.obs,cl=sample_distribution$CL[i],
vc=sample_distribution$V[i],
dose=dose)
sim<-as.data.frame(y) %>%
mutate(lev.dose=lev.dose[j])
simLE[[i+(10000*(j-1))]]<-sim
}
}
simlecmin<-bind_rows(simLE) %>%
filter(time!=0)
simlecmin<-simlecmin[rep(c(1:nrow(simlecmin)),9),]
simlecmin$TCMIN<-(rep(c(5,10,12,20,30,40,46,50,60),
each=0.5*nrow(bind_rows(simLE))))
simlecmin %>%
mutate(TMIC=ifelse(conc>TCMIN,1,0))%>%
group_by(TCMIN,lev.dose) %>%
summarise(percover=round(100*sum(TMIC)/10000,1)) %>%
ungroup() %>%
kable(booktabs=TRUE,
caption = "Percentage of simulated patients achieving trough concentration",
col.names = c("Target trough (mg/L)", "Simulated dose (mg)","Percentage of simulated patients achieving"))
simlecmin %>%
mutate(TMIC=ifelse(conc>TCMIN,1,0))%>%
group_by(TCMIN,lev.dose) %>%
summarise(percover=round(100*sum(TMIC)/10000,1)) %>%
ungroup() %>%
kable(booktabs=TRUE,
caption = "Percentage of simulated patients achieving trough concentration",
col.names = c("Target trough (mg/L)", "Simulated dose (mg/12-hours)","Percentage of simulated patients achieving"))
library(gtsummary)
simlecmin %>%
filter(TCMIN==10) %>%
dplyr::select(conc,lev.dose) %>%
tbl_summary(by=lev.dose,statistic=all_continuous()~c("{median} ({p10}-{p90})"),
label=c(lev.dose~"levetiracetam dose (mg)", conc~"Cmin (mg/L)"))%>%
modify_header(label="")%>%
modify_header(all_stat_cols() ~ "**{level}**") %>%
modify_spanning_header(all_stat_cols() ~ "Levetiracetam dose (mg)")  %>%
as_kable_extra(booktabs=TRUE,
caption="Trough concentration profile for a range of simulated levetiracetam doses during continuous renal replacement therapy")
library(gtsummary)
simlecmin %>%
filter(TCMIN==10) %>%
dplyr::select(conc,lev.dose) %>%
tbl_summary(by=lev.dose,statistic=all_continuous()~c("{median} ({p10}-{p90})"),
label=c(lev.dose~"levetiracetam dose (mg)", conc~"Cmin (mg/L)"))%>%
modify_header(label="")%>%
modify_header(all_stat_cols() ~ "**{level}**") %>%
modify_spanning_header(all_stat_cols() ~ "Levetiracetam dose (mg/12-hours)")  %>%
as_kable_extra(booktabs=TRUE,
caption="Trough concentration profile for a range of simulated levetiracetam doses during continuous renal replacement therapy")
simlecmintrough<-simlecmin %>%
mutate(TMIC=ifelse(conc>TCMIN,1,0))%>%
group_by(TCMIN,lev.dose) %>%
summarise(percover=round(100*sum(TMIC)/10000,1))
simlecmintrough$lev.dose<-as.factor(simlecmintrough$lev.dose)
ggplot(simlecmintrough,aes(x=TCMIN,y=percover,group=lev.dose,col=lev.dose))+
geom_point()+
geom_line()+
#expand_limits(x = 0, y = 0)+
theme_bw(base_size=12)+
labs(y = "Percentage of simulated patients achieving trough concentration", x="Trough concentration)")
ggplot(simlecmintrough,aes(x=TCMIN,y=percover,group=lev.dose,col=lev.dose))+
geom_point()+
geom_line()+
#expand_limits(x = 0, y = 0)+
theme_bw(base_size=12)+
labs(y = "Percentage of simulated patients achieving trough concentration", x="Trough concentration)",col='leveteracetam dose (mg/12 hours)')
# No loading dose for this sim
# Will then stick with the 250/500/750/1000 twice daily maintenance dose
lev.dose<-c(250,500,750,1000)
t.obs<-seq(0,71.9,0.1)
simLE<-list()
for(j in c(1:length(lev.dose))){
for(i in c(1:nrow(sample_distribution))){
dose<-data.frame(t.dose=c(seq(0,72,12)),amt=lev.dose[j])
y<-pkprofile(t.obs,cl=sample_distribution$CL[i],
vc=sample_distribution$V[i],
dose=dose)
sim<-as.data.frame(y) %>%
mutate(lev.dose=lev.dose[j])
simLE[[i+(10000*(j-1))]]<-sim
}
}
simlecmin<-bind_rows(simLE)
#calculate quantiles by grouping variable
plottab <-simlecmin %>%
group_by(lev.dose,time) %>%
summarize(ten = quantile(conc, probs = 0.1),
median = median(conc),
ninety = quantile(conc, probs = 0.9)) %>%
ungroup()
ggplot(plottab,aes(x=time,y=median))+
geom_ribbon(aes(ymin=ten,ymax=ninety),fill="lightblue",alpha=0.8)+
geom_line(linetype="dashed")+
labs(y = "Leviteracetam concentration (mg/L)", x="Time (hours)")+
theme_bw(base_size=12)+
theme(strip.background=element_rect(fill=NA, color=NA))+
geom_ribbon(aes(ymin=12, ymax=46),col=NA,fill='salmon',alpha=0.4)+
facet_wrap(vars(lev.dose))+
theme(legend.position="none")
